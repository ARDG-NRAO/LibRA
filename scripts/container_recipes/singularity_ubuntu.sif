Bootstrap: docker
From: nvidia/cuda:12.9-devel-ubuntu24.04
%files
 readline.pc /
%labels
 Author pjaganna@nrao.edu
 Version v0.0.2
%post
 # Update package lists
 apt-get update
 
 # Install basic development tools
 apt-get install -y git cmake gcc g++ gfortran ccache flex bison tar curl bzip2
 
 # Install development packages for casacore and LibRA
 apt-get install -y \
   libgtest-dev \
   libreadline-dev \
   libncurses-dev \
   libblas-dev \
   liblapack-dev \
   libcfitsio-dev \
   libfftw3-dev \
   wcslib-dev \
   libgsl-dev \
   libeigen3-dev \
   libopenmpi-dev \
   python3-dev \
   python3-pip \
   pkg-config
 
 # Move readline.pc to correct location for Ubuntu
 mv /readline.pc /usr/lib/x86_64-linux-gnu/pkgconfig/
 
 # Clone LibRA repository
 git clone https://github.com/ARDG-NRAO/LibRA.git libra
 cd libra
 mkdir build
 cd build
 
 # Check if running on Crave and set appropriate CUDA arch
 if [ -f /opt/crave/.crave_marker ] || [ "$CRAVE_ENVIRONMENT" = "1" ]; then
   CUDA_ARCH_FLAG="-DKokkos_CUDA_ARCH_NAME=Kokkos_ARCH_AMPERE80"
   echo "Detected Crave environment, using Ampere 80 architecture"
 else
   CUDA_ARCH_FLAG="-DKokkos_CUDA_ARCH_NAME=Kokkos_ARCH_HOPPER90"
   echo "Using default Hopper 90 architecture"
 fi
 
 # Configure and build LibRA
 cmake -DApps_BUILD_TESTS=ON $CUDA_ARCH_FLAG ..
 make
 
 # Clean up package cache to reduce image size
 apt-get clean
 rm -rf /var/lib/apt/lists/*

%test
 nvcc --version > /tmp/nvcc_version.txt
 echo "nvcc version is $(cat /tmp/nvcc_version.txt)"
 nvidia-smi > /tmp/nvidia-smi.txt
 echo "nvidia-smi is $(cat /tmp/nvidia-smi.txt)"
 
 # Test that apps were built successfully
 ls -la /libra/apps/src/
 echo "LibRA apps available:"
 find /libra/apps/src/ -type f -executable | head -10
 exit 0

%environment
 export PIP_ROOT_USER_ACTION=ignore
 export PATH=/libra/apps/src/:/libra/dependencies/linux_64b/bin/:/libra/dependencies/linux_64b/sbin/:$PATH
 export LD_LIBRARY_PATH=/libra/apps/src/:/libra/dependencies/linux_64b/lib/:$LD_LIBRARY_PATH

%runscript
 # Check if an argument was provided
 if [ $# -eq 0 ]; then
   echo "Available LibRA applications:"
   find /libra/apps/src/ -type f -executable -printf "%f\n" | sort
   echo ""
   echo "Usage: singularity run container.sif <app_name> [args...]"
   echo "Example: singularity run container.sif roadrunner"
 else
   # Run the specified application with any additional arguments
   APP_NAME="$1"
   shift
   APP_PATH="/libra/apps/src/$APP_NAME"
   
   if [ -f "$APP_PATH" ] && [ -x "$APP_PATH" ]; then
     exec "$APP_PATH" "$@"
   else
     echo "Error: Application '$APP_NAME' not found or not executable"
     echo "Available applications:"
     find /libra/apps/src/ -type f -executable -printf "%f\n" | sort
     exit 1
   fi
 fi

%help
 This container holds the LibRA suite of radio astronomy applications built with CUDA support.
 
 Building the container:
   singularity build --fakeroot libra.sif libra.def
 
 Running applications:
   # List available apps
   singularity run --nv libra.sif
   
   # Run a specific app
   singularity run --nv libra.sif roadrunner [arguments]
   singularity run --nv libra.sif <app_name> [arguments]
 
 Mounting external data:
   singularity run --nv --bind /host/data:/container/data libra.sif <app_name>
 
 The container automatically detects Crave environments and uses appropriate CUDA architecture.
 Default architecture is Hopper 90, with fallback to Ampere 80 for Crave.